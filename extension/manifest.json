{
  "manifest_version": 3,
  "name": "Chénuke",
  "version": "0.5.3",
  "description": "Detecta señales estructurales de manipulación, urgencia artificial y promesas desproporcionadas en cualquier página web.",
  "author": "Ernesto F. Dominguez",
  "homepage_url": "https://chenuke.com",
  "minimum_chrome_version": "105",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chénuke",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://chenuke-production-8e78.up.railway.app/*",
    "https://chenuke.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://chenuke-production-8e78.up.railway.app https://chenuke.com"
  }
}